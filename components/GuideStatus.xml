<?xml version="1.0" encoding="utf-8" ?>
<component name="GuideStatus" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/GuideStatus.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils.brs" />
  <interface>
    <!-- input from the scene: { kind: "loading" | "ready" | "extended" | "hide", channels, through (epoch) } -->
    <field id="show" type="assocarray" alwaysNotify="true" onChange="onShow" />
    <!-- overscan insets in screen pixels [left, top, right, bottom]; the scene doesn't move or scale this view -->
    <field id="safe" type="array" onChange="onSafe" />
  </interface>
  <children>
    <!-- a card in the top right corner while the guide downloads, then what it got. Drawn at full size (never
         scaled), so it stays sharp; GuideStatus.brs places it. -->
    <Group id="card" opacity="0">
      <Poster id="cardBg" uri="pkg:/images/round.9.png" width="560" height="124" blendColor="0x0B2A6AFF" opacity="0.95" />
      <Rectangle id="accent" translation="[0,18]" width="6" height="88" color="0x4F86E8FF" />
      <Group id="glyph" translation="[30,36]" />
      <Label id="titleLbl" translation="[110,20]" width="420" height="44" vertAlign="center" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
      <Label id="subLbl" translation="[110,62]" width="420" height="34" vertAlign="center" color="0xB4C3E2FF" font="font:MediumSystemFont" />
      <!-- the bar along the bottom: a sliding segment while it loads, then the time left before the card goes -->
      <Group id="barClip" translation="[110,104]">
        <Rectangle id="track" width="420" height="5" color="0xFFFFFF26" />
        <Rectangle id="seg" width="120" height="5" color="0x4F86E8FF" />
        <Rectangle id="fill" width="420" height="5" color="0x2ED47AFF" visible="false" />
      </Group>
    </Group>

    <Animation id="fadeIn" duration="0.3" easeFunction="outCubic">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="card.opacity" />
      <Vector2DFieldInterpolator id="slideIn" key="[0.0, 1.0]" fieldToInterp="card.translation" />
    </Animation>
    <Animation id="fadeOut" duration="0.35" easeFunction="inCubic">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="card.opacity" />
    </Animation>
    <Animation id="sweep" duration="1.1" repeat="true" easeFunction="inOutQuad">
      <Vector2DFieldInterpolator key="[0.0, 1.0]" keyValue="[[-120, 0], [420, 0]]" fieldToInterp="seg.translation" />
    </Animation>
    <Animation id="countdown" duration="4.5" easeFunction="linear">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[420.0, 0.0]" fieldToInterp="fill.width" />
    </Animation>
  </children>
</component>
