<?xml version="1.0" encoding="utf-8" ?>
<component name="JumpPad" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/JumpPad.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils.brs" />
  <interface>
    <!-- the channel number picked with Go (digits only) -->
    <field id="result" type="string" alwaysNotify="true" />
    <!-- Back: closed without a number -->
    <field id="closeRequest" type="boolean" alwaysNotify="true" />
    <function name="openPad" />
    <function name="closePad" />
  </interface>
  <children>
    <Rectangle translation="[-200,-200]" width="2320" height="1480" color="0x000000A8" />
    <Group id="panel" />
  </children>
</component>
