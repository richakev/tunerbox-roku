<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeView" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/HomeView.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils.brs" />
  <interface>
    <!-- inputs from the scene -->
    <field id="baseUrl" type="string" />
    <!-- this Roku's recent channel numbers, newest first, comma-separated (Home > Recent channels) -->
    <field id="recent" type="string" />
    <!-- outputs to the scene: { type: "close" | "pick" (item) | "fav" (num) | "nav" (id) } -->
    <field id="request" type="assocarray" alwaysNotify="true" />
    <!-- where the live-TV preview sits, in this view's own coordinates [x, y, w, h] -->
    <field id="previewRect" type="array" />
    <function name="openHome" />
    <function name="closeHome" />
    <function name="reload" />
  </interface>
  <children>
    <!-- live TV plays full screen behind Home (as the web Home on a TV); these darken it so the text reads:
         the left side, the bottom and the top bar. Oversized so they still reach the screen edges when scaled
         into the safe area. -->
    <Poster uri="pkg:/images/home_left.png" translation="[-200,-200]" width="2320" height="1480" blendColor="0x08163AFF" />
    <Poster uri="pkg:/images/home_bottom.png" translation="[-200,0]" width="2320" height="1280" blendColor="0x08163AFF" />
    <Poster uri="pkg:/images/home_top.png" translation="[-200,-200]" width="2320" height="373" blendColor="0x08163AFF" />

    <!-- top bar (as the web Home): TunerBox, the shortcuts, and the time and date on the right -->
    <Label id="brandLbl" translation="[40,20]" height="56" vertAlign="center" text="Tuner" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
    <Label id="brand2Lbl" translation="[150,20]" height="56" vertAlign="center" text="Box" color="0xFFC845FF" font="font:LargeBoldSystemFont" />
    <Label id="clockLbl" translation="[1500,20]" height="56" vertAlign="center" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
    <Label id="dateLbl" translation="[1700,20]" height="56" vertAlign="center" color="0x9FB3DCFF" font="font:SmallSystemFont" />

    <!-- the highlighted tile's details, on the left over the picture (placed by drawInfo) -->
    <Label id="titleLbl" translation="[40,110]" width="1030" wrap="true" maxLines="2" lineSpacing="0" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
    <Label id="subLbl" translation="[40,200]" width="1030" height="40" vertAlign="center" color="0xC5D3EFFF" font="font:MediumSystemFont" />
    <Label id="metaLbl" translation="[40,240]" width="1030" height="36" vertAlign="center" color="0xFFC845FF" font="font:SmallSystemFont" />
    <Label id="descLbl" translation="[40,280]" width="1030" vertAlign="top" wrap="true" maxLines="3" color="0xAFC8F5FF" font="font:SmallSystemFont" />

    <Group id="rowsGroup" />
    <Label id="msgLbl" translation="[260,560]" width="1400" height="200" horizAlign="center" vertAlign="center" wrap="true" color="0xDCE8FFFF" font="font:MediumSystemFont" />
    <!-- key hints along the bottom, as the web Home's footer -->
    <Group id="hintsGroup" translation="[40,1028]" />

    <Timer id="refreshTimer" duration="60" repeat="true" />
    <Timer id="clockTimer" duration="20" repeat="true" />
  </children>
</component>
