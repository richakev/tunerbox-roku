<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerHud" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/PlayerHud.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils.brs" />
  <interface>
    <field id="buttonSelected" type="string" alwaysNotify="true" />
    <field id="muted" type="boolean" value="false" onChange="onMuted" />
    <field id="isFav" type="boolean" value="false" onChange="onFav" />
    <!-- Home first on the bar (only when TunerBox's Home screen is on) -->
    <field id="showHome" type="boolean" value="false" onChange="onShowHome" />
    <function name="showBanner" />
    <function name="showBar" />
    <function name="hideAll" />
    <function name="showVod" />
    <function name="updateVod" />
  </interface>
  <children>
    <Group id="bar" visible="false" />
    <!-- lower third (as the web banner): the picture fades into the theme's background behind the text.
         Extends past the screen edges so it still reaches them when scaled into the safe area. -->
    <Group id="banner" visible="false" translation="[0,840]">
      <Poster id="bannerFade" uri="pkg:/images/fade.png" translation="[-200,-190]" width="2320" height="420" blendColor="0x08163AFF" />
      <Rectangle translation="[-200,230]" width="2320" height="220" color="0x08163AF7" />
      <!-- one row, as the web: the channel number, its logo on a light card, then the show; clock on the right
           (placed by fillBanner) -->
      <Label id="chNum" translation="[40,62]" height="110" vertAlign="center" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Poster id="chLogoBg" uri="pkg:/images/round.9.png" translation="[0,78]" width="150" height="80" blendColor="0xFFFFFFFF" />
      <Poster id="chLogo" translation="[0,84]" width="130" height="68" loadDisplayMode="scaleToFit" />
      <Label id="chName" visible="false" />
      <Label id="titleLbl" translation="[300,60]" height="58" vertAlign="center" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Group id="badge" visible="false">
        <Poster id="badgeRect" uri="pkg:/images/round.9.png" width="80" height="32" blendColor="0x4A5568FF" />
        <Label id="badgeLbl" width="80" height="32" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" font="font:SmallBoldSystemFont" />
      </Group>
      <Label id="subLbl" translation="[300,120]" width="1100" height="38" vertAlign="center" color="0x9FB3DCFF" font="font:SmallSystemFont" />
      <Label id="timesLbl" visible="false" />
      <Poster id="progBg" uri="pkg:/images/bar.9.png" translation="[300,168]" width="440" height="10" blendColor="0x3A63A8FF" />
      <Poster id="progFill" uri="pkg:/images/bar.9.png" translation="[300,168]" width="0" height="10" blendColor="0xFFC845FF" />
      <Label id="nextLbl" translation="[300,186]" width="1300" height="34" vertAlign="center" color="0x9FB3DCFF" font="font:SmallSystemFont" />
      <Label id="clockLbl" translation="[1480,62]" width="400" height="60" horizAlign="right" vertAlign="center" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Label id="dateLbl" translation="[1480,122]" width="400" height="36" horizAlign="right" vertAlign="center" color="0x9FB3DCFF" font="font:SmallSystemFont" />
    </Group>
    <Timer id="hideTimer" duration="6" repeat="false" />
  </children>
</component>
