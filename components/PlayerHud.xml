<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerHud" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/PlayerHud.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils.brs" />
  <interface>
    <field id="buttonSelected" type="string" alwaysNotify="true" />
    <field id="muted" type="boolean" value="false" onChange="onMuted" />
    <field id="isFav" type="boolean" value="false" onChange="onFav" />
    <function name="showBanner" />
    <function name="showBar" />
    <function name="hideAll" />
    <function name="showVod" />
    <function name="updateVod" />
  </interface>
  <children>
    <Group id="bar" visible="false" />
    <!-- background extends past the screen edges so it still reaches them when scaled into the safe area -->
    <Group id="banner" visible="false" translation="[0,840]">
      <Rectangle id="bannerBg" translation="[-200,0]" width="2320" height="440" color="0x0D3B86F2" />
      <Rectangle translation="[-200,0]" width="2320" height="3" color="0x6FA0F0FF" />
      <Label id="chNum" translation="[24,10]" width="250" height="80" horizAlign="center" vertAlign="center" color="0xFFC845FF" font="font:LargeBoldSystemFont" />
      <Poster id="chLogo" translation="[86,94]" width="126" height="68" loadDisplayMode="scaleToFit" />
      <Label id="chName" translation="[24,166]" width="250" height="40" horizAlign="center" vertAlign="center" color="0xCFE0FFFF" font="font:SmallBoldSystemFont" />
      <Rectangle translation="[290,20]" width="2" height="190" color="0x2F5FB0FF" />
      <Label id="titleLbl" translation="[316,12]" height="64" vertAlign="center" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Group id="badge" translation="[900,25]" visible="false">
        <Rectangle id="badgeRect" width="80" height="38" color="0x5A6B85FF" />
        <Label id="badgeLbl" width="80" height="38" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" font="font:SmallBoldSystemFont" />
      </Group>
      <Label id="subLbl" translation="[316,80]" width="1150" height="42" vertAlign="center" color="0xDCE8FFFF" font="font:MediumSystemFont" />
      <Label id="timesLbl" translation="[316,126]" width="300" height="38" vertAlign="center" color="0xAFC8F5FF" font="font:SmallSystemFont" />
      <Rectangle id="progBg" translation="[626,140]" width="480" height="10" color="0x3A63A8FF" />
      <Rectangle id="progFill" translation="[626,140]" width="0" height="10" color="0xFFC845FF" />
      <Label id="nextLbl" translation="[316,168]" width="1250" height="38" vertAlign="center" color="0xAFC8F5FF" font="font:SmallSystemFont" />
      <Label id="clockLbl" translation="[1480,16]" width="418" height="64" horizAlign="right" vertAlign="center" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Label id="dateLbl" translation="[1480,82]" width="418" height="36" horizAlign="right" vertAlign="center" color="0xAFC8F5FF" font="font:SmallSystemFont" />
    </Group>
    <Timer id="hideTimer" duration="6" repeat="false" />
  </children>
</component>
