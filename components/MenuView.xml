  <script type="text/brightscript" uri="pkg:/source/utils.brs" />
  <interface>
    <field id="items" type="array" onChange="onItems" />
    <field id="subtitle" type="string" onChange="onItems" />
    <field id="heading" type="string" value="Menu" onChange="onItems" />
    <field id="selected" type="string" alwaysNotify="true" />
