<?xml version="1.0" encoding="utf-8" ?>
<component name="OnDemandView" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/OnDemandView.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils.brs" />
  <interface>
    <!-- inputs from the scene -->
    <field id="baseUrl" type="string" />
    <!-- action id of the button picked in a dialog this view asked for -->
    <field id="dialogAction" type="string" alwaysNotify="true" onChange="onDialogAction" />
    <!-- text typed in the search keyboard -->
    <field id="searchText" type="string" alwaysNotify="true" onChange="onSearchText" />
    <!-- outputs to the scene: { type: "close" | "dialog" | "keyboard" | "play" | "toast", ... } -->
    <field id="request" type="assocarray" alwaysNotify="true" />
    <!-- where the live-TV preview sits, in this view's own coordinates [x, y, w, h] -->
    <field id="previewRect" type="array" />
    <function name="openOD" />
    <function name="reopenOD" />
    <function name="closeOD" />
  </interface>
  <children>
    <!-- background with a hole for the live-TV preview (top left); oversized so it still reaches the screen
         edges when scaled into the safe area -->
    <Rectangle translation="[-200,-200]" width="2320" height="230" color="0x08183AFF" />
    <Rectangle translation="[-200,30]" width="240" height="315" color="0x08183AFF" />
    <Rectangle translation="[600,30]" width="1520" height="315" color="0x08183AFF" />
    <Rectangle translation="[-200,345]" width="2320" height="935" color="0x08183AFF" />
    <Rectangle translation="[36,26]" width="568" height="4" color="0x4F86E8FF" />
    <Rectangle translation="[36,345]" width="568" height="4" color="0x4F86E8FF" />
    <Rectangle translation="[36,26]" width="4" height="323" color="0x4F86E8FF" />
    <Rectangle translation="[600,26]" width="4" height="323" color="0x4F86E8FF" />

    <Label id="titleLbl" translation="[640,24]" width="840" height="62" vertAlign="center" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
    <Label id="metaLbl" translation="[640,88]" width="1240" height="38" vertAlign="center" color="0xDCE8FFFF" font="font:MediumSystemFont" />
    <Label id="srcLbl" translation="[640,128]" width="1240" height="34" vertAlign="center" color="0xFFC845FF" font="font:SmallSystemFont" />
    <Label id="plotLbl" translation="[640,168]" width="1240" height="112" vertAlign="top" wrap="true" maxLines="3" color="0xFFFFFFFF" font="font:SmallSystemFont" />
    <Label id="castLbl" translation="[640,290]" width="1240" height="34" vertAlign="center" color="0xA9BEE8FF" font="font:SmallSystemFont" />
    <Label id="clockLbl" translation="[1500,24]" width="380" height="40" horizAlign="right" vertAlign="center" color="0xFFFFFFFF" font="font:SmallBoldSystemFont" />
    <Label id="dateLbl" translation="[1500,62]" width="380" height="34" horizAlign="right" vertAlign="center" color="0xAFC8F5FF" font="font:SmallSystemFont" />

    <Rectangle translation="[40,365]" width="1840" height="60" color="0x1A4597FF" />
    <Label id="sideHead" translation="[56,365]" width="380" height="60" vertAlign="center" color="0xFFC845FF" font="font:SmallBoldSystemFont" />
    <Group id="tabsGroup" />
    <Group id="sideGroup" />
    <Group id="mainGroup" />
    <Label id="msgLbl" translation="[480,560]" width="1380" height="160" horizAlign="center" vertAlign="center" wrap="true" color="0xDCE8FFFF" font="font:MediumSystemFont" />
    <Label id="footLbl" translation="[40,1030]" width="1840" height="40" vertAlign="center" color="0xC5D3EFFF" font="font:SmallSystemFont" />

    <Timer id="infoTimer" duration="0.4" repeat="false" />
    <Timer id="tabTimer" duration="0.45" repeat="false" />
    <Timer id="catTimer" duration="0.35" repeat="false" />
    <Timer id="clockTimer" duration="20" repeat="true" />
  </children>
</component>
